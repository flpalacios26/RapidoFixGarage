<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="RapidoFixGarage.Forms.Site" %>

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title>RápidoFix Garage — Gestión de Taller</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Century Gothic', 'CenturyGothic', 'AppleGothic', sans-serif; background: #F8FAFC; color: #1E293B; }
        input, textarea, select, button, table, th, td, a, h1, h2, h3, p, label, span { font-family: 'Century Gothic', 'CenturyGothic', 'AppleGothic', sans-serif; }

        .topbar { background: #0B3D91; color: white; padding: 18px 40px; display: flex; align-items: center; justify-content: space-between; box-shadow: 0 2px 10px rgba(0,0,0,.15); }
        .brand { display: flex; align-items: center; gap: 12px; font-size: 22px; font-weight: 700; }
        .brand .logo { width: 38px; height: 38px; border-radius: 8px; background: linear-gradient(135deg,#06B6D4,#2563EB); display: flex; align-items: center; justify-content: center; font-size: 20px; }
        .brand span.accent { color: #06B6D4; }
        .user-info { font-size: 14px; opacity: .9; }

        .mainnav { background: white; border-bottom: 1px solid #E2E8F0; padding: 0 40px; display: flex; gap: 4px; box-shadow: 0 2px 4px rgba(0,0,0,.02); }
        .mainnav a { padding: 16px 20px; color: #475569; text-decoration: none; font-weight: 600; font-size: 14px; border-bottom: 3px solid transparent; transition: all .2s; }
        .mainnav a:hover { color: #0B3D91; background: #F1F5F9; }
        .mainnav a.active { color: #0B3D91; border-bottom-color: #06B6D4; }

        .wrapper { max-width: 1250px; margin: 0 auto; padding: 32px 24px; }

        .hero { background: linear-gradient(135deg,#0B3D91 0%,#1E40AF 60%,#06B6D4 140%); color: white; border-radius: 16px; padding: 40px; margin-bottom: 32px; box-shadow: 0 4px 15px rgba(11,61,145,.2); }
        .hero h1 { font-size: 30px; margin-bottom: 8px; }
        .hero p { opacity: .9; font-size: 16px; line-height: 1.5; }

        .kpi-grid { display: grid; grid-template-columns: repeat(auto-fit,minmax(220px,1fr)); gap: 20px; margin-bottom: 32px; }
        .kpi { background: white; border-radius: 14px; padding: 24px; box-shadow: 0 2px 8px rgba(15,23,42,.06); border-left: 5px solid #2563EB; }
        .kpi .kpi-label { font-size: 13px; color: #64748B; text-transform: uppercase; letter-spacing: .5px; }
        .kpi .kpi-value { font-size: 32px; font-weight: 800; color: #0B3D91; margin-top: 6px; }
        .kpi.green { border-left-color: #10B981; }
        .kpi.cyan  { border-left-color: #06B6D4; }
        .kpi.amber { border-left-color: #F59E0B; }

        .section-title { font-size: 22px; font-weight: 700; color: #0B3D91; margin: 32px 0 16px; display: flex; align-items: center; gap: 10px; }
        .features { display: grid; grid-template-columns: repeat(auto-fit,minmax(280px,1fr)); gap: 20px; margin-bottom: 32px; }
        .feature-card { background: white; border-radius: 14px; padding: 24px; box-shadow: 0 2px 8px rgba(15,23,42,.06); border: 1px solid #E2E8F0; transition: all .2s; }
        .feature-card:hover { transform: translateY(-4px); box-shadow: 0 8px 20px rgba(15,23,42,.1); }
        .feature-card .icon { width: 46px; height: 46px; border-radius: 10px; margin-bottom: 14px; background: linear-gradient(135deg,#2563EB,#06B6D4); display: flex; align-items: center; justify-content: center; font-size: 22px; color: white; }
        .feature-card h3 { font-size: 16px; color: #0B3D91; margin-bottom: 8px; }
        .feature-card p { font-size: 14px; color: #64748B; line-height: 1.5; }
        .feature-card a { display: inline-block; margin-top: 12px; color: #2563EB; text-decoration: none; font-weight: 600; font-size: 14px; }
        .feature-card a:hover { color: #0B3D91; text-decoration: underline; }

        .card { background: white; border-radius: 14px; padding: 28px; box-shadow: 0 2px 8px rgba(15,23,42,.06); margin-bottom: 24px; border: 1px solid #E2E8F0; }
        .card h2 { color: #0B3D91; font-size: 18px; margin-bottom: 20px; border-bottom: 1px solid #E2E8F0; padding-bottom: 10px; }

        .form-row { display: grid; grid-template-columns: repeat(auto-fit,minmax(240px,1fr)); gap: 16px; margin-bottom: 16px; }
        .form-row label { display: block; font-size: 13px; font-weight: 600; color: #475569; margin-bottom: 6px; }
        .form-row input, .form-row select, .form-row textarea { width: 100%; padding: 10px 12px; border: 1px solid #CBD5E1; border-radius: 8px; font-size: 14px; transition: .2s; }
        .form-row input:focus, .form-row select:focus, .form-row textarea:focus { outline: none; border-color: #2563EB; box-shadow: 0 0 0 3px rgba(37,99,235,.15); }

        .btn { background: #2563EB; color: white; border: none; padding: 11px 22px; border-radius: 8px; cursor: pointer; font-weight: 600; font-size: 14px; transition: .2s; display: inline-block; }
        .btn:hover { background: #1D4ED8; }
        .btn-secondary { background: #06B6D4; }
        .btn-secondary:hover { background: #0891B2; }

        table.data { width: 100%; border-collapse: collapse; background: white; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 8px rgba(15,23,42,.06); }
        table.data thead { background: #0B3D91; color: white; }
        table.data th, table.data td { padding: 12px 14px; text-align: left; font-size: 14px; }
        table.data tbody tr { border-bottom: 1px solid #E2E8F0; }
        table.data tbody tr:hover { background: #F1F5F9; }

        .badge { padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 600; }
        .badge-open   { background: #D1FAE5; color: #065F46; }
        .badge-closed { background: #FEE2E2; color: #991B1B; }
        .badge-low    { background: #FEF3C7; color: #92400E; }
    </style>
</head>
<body>
    <form id="form1" runat="server">
        <div class="topbar">
            <div class="brand">
                <div class="logo">🔧</div>
                <div>Rápido<span class="accent">Fix</span> Garage</div>
            </div>
            <div class="user-info">Plataforma de gestión integral del taller</div>
        </div>

        <div class="mainnav">
            <a href="Dashboard.aspx">🏠 Inicio</a>
            <a href="Clientes.aspx">👤 Clientes</a>
            <a href="Vehiculos.aspx">🚗 Vehículos</a>
            <a href="Ordenes.aspx">🧾 Órdenes</a>
            <a href="Repuestos.aspx">📦 Repuestos</a>
            <a href="Reportes.aspx">📊 Reportes</a>
        </div>

        <div class="wrapper">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </div>
    </form>
</body>
</html>
